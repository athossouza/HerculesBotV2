graph TD
    %% Nodes
    User((User))
    
    subgraph ZD [Zendesk Ecosystem]
        SunCo[Sunshine Conversations API]
        Switchboard{Switchboard}
        Human[Human Agent]
    end
    
    subgraph SERVER [Hercules Bot Server]
        Webhook[Webhook Endpoint]
        Buffer{Message Buffer}
        Workflow[HerculesWorkflow Engine]
        Logger[(In-Memory Logs)]
        
        subgraph LLM [LLM Layer]
            Router[Intent Classifier]
            Guard[Guardrails]
            Generator[Response Generator]
        end
    end
    
    OpenAI((OpenAI API))
    Dashboard[Web Dashboard]

    %% Flow - Inbound
    User -- Message --> SunCo
    SunCo -- Webhook Event --> Webhook
    Webhook -- Add to Queue --> Buffer
    Buffer -- Wait 2.0s --> Buffer
    Buffer -- Batch Process --> Workflow
    
    %% Flow - Workflow logic
    Workflow --> Router & Guard
    Router & Guard & Generator <--> OpenAI
    
    %% Flow - Outbound (Reply)
    Workflow -- Reply Text --> Webhook
    Webhook -- POST /messages --> SunCo
    SunCo --> User
    
    %% Flow - Outbound (Handoff)
    Workflow -- State: HANDOFF --> Webhook
    Webhook -- POST /passControl --> Switchboard
    Switchboard -- Transfer --> Human
    Human -- Chat --> User

    %% Flow - Dashboard
    Dashboard <--> Webhook & Logger

    %% Styles
    style User fill:#f9f,stroke:#333
    style SunCo fill:#9cf,stroke:#333
    style Switchboard fill:#f96,stroke:#333
    style Human fill:#fcc,stroke:#333
