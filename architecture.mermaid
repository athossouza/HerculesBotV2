stateDiagram-v2
    [*] --> START
    START --> ROUTE_INTENT: User Message
    
    ROUTE_INTENT --> REQUEST_WINDING_DATA: Intent = winding_data
    ROUTE_INTENT --> SUPPORT_FLOW: Intent = tech_support
    ROUTE_INTENT --> SUPPORT_FLOW: Intent = fallback

    state REQUEST_WINDING_DATA {
        [*] --> RESTRICTED_ASK_PASSWORD
        RESTRICTED_ASK_PASSWORD --> RESTRICTED_VERIFY_PASSWORD: User provides password
        
        RESTRICTED_VERIFY_PASSWORD --> RESTRICTED_ASK_SERIAL: Password Valid
        RESTRICTED_VERIFY_PASSWORD --> HANDOFF_HUMAN: Max Attempts Exceeded
        RESTRICTED_VERIFY_PASSWORD --> RESTRICTED_ASK_PASSWORD: Password Invalid (Retry)
        
        RESTRICTED_ASK_SERIAL --> RESTRICTED_VERIFY_SERIAL_FORMAT: User provides serial
        
        RESTRICTED_VERIFY_SERIAL_FORMAT --> RESTRICTED_CHECK_SERIAL_AGE: Format Valid
        RESTRICTED_VERIFY_SERIAL_FORMAT --> RESTRICTED_ASK_SERIAL: Invalid Format (Retry)
        
        RESTRICTED_CHECK_SERIAL_AGE --> RESTRICTED_DELIVER_MOCK_PDF: Serial Age >= 3 (New)
        RESTRICTED_CHECK_SERIAL_AGE --> HANDOFF_HUMAN: Serial Age < 3 (Old)
    }

    state SUPPORT_FLOW {
        [*] --> GENERAL_CHAT
        GENERAL_CHAT --> GENERAL_CHAT: LLM Reply
    }

    RESTRICTED_DELIVER_MOCK_PDF --> END
    HANDOFF_HUMAN --> END
    SUPPORT_FLOW --> END: User says bye
